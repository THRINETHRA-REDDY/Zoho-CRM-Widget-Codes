{
	return "<error><message>No contacts found.</message></error>";
}
phonesJson = standalone.getContactPhones(contactId);
// Extract Home_Phone
homePhone = "";
if(phonesJson != null && phonesJson.contains("\"Home_Phone\":\""))
{
	startIdx = phonesJson.indexOf("\"Home_Phone\":\"") + "\"Home_Phone\":\"".length();
	endIdx = phonesJson.indexOf("\"",startIdx);
	if(endIdx > startIdx)
	{
		homePhone = phonesJson.subString(startIdx,endIdx);
	}
}
// Extract Mobile
mobile = "";
if(phonesJson != null && phonesJson.contains("\"Mobile\":\""))
{
	startIdx = phonesJson.indexOf("\"Mobile\":\"") + "\"Mobile\":\"".length();
	endIdx = phonesJson.indexOf("\"",startIdx);
	if(endIdx > startIdx)
	{
		mobile = phonesJson.subString(startIdx,endIdx);
	}
}
