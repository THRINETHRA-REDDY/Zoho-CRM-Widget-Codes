phoneFLHome = "<FL val=\"Home Phone\"> </FL>";
if(homePhone != null && homePhone != "")
{
	homeDigits = homePhone.replaceAll("-","");
	phoneFLHome = "<FL val=\"Home Phone\" link=\"true\" url=\"tel:" + homeDigits + "\">" + standalone.XMLEscape(homePhone) + "</FL>";
}
// Build Mobile FL
phoneFLMobile = "<FL val=\"Mobile\"> </FL>";
if(mobile != null && mobile != "")
{
	mobileDigits = mobile.replaceAll("-","");
	phoneFLMobile = "<FL val=\"Mobile\" link=\"true\" url=\"tel:" + mobileDigits + "\">" + standalone.XMLEscape(mobile) + "</FL>";
}
