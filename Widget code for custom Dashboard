<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Economic Development &amp; Culture — CRM Home</title>
<style>
  :root{
    --bg-0:#0B1220;
    --bg-1:#101B30;
    --bg-2:#152238;
    --line:#243554;
    --text-hi:#F3F6FC;
    --text-mid:#AEBBD4;
    --text-lo:#7C8AAA;
    --blue:#5B9CF6;
    --blue-soft:#2A4C86;
    --teal:#33C9B0;
    --amber:#F0B44C;
    --coral:#F0765C;
    --violet:#9B87F5;
    --green:#3FCF8E;
    --radius:16px;
  }
  *{box-sizing:border-box;}
  html,body{
    margin:0;padding:0;
    background:radial-gradient(1200px 600px at 15% -10%, #16264A 0%, var(--bg-0) 55%);
    color:var(--text-hi);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,Helvetica,Arial,sans-serif;
  }
  .wrap{max-width:1320px;margin:0 auto;padding:28px 28px 40px;}

  /* header */
  .head{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:22px;flex-wrap:wrap;gap:14px;}
  .head h1{font-size:22px;font-weight:700;margin:0 0 4px;letter-spacing:-0.01em;}
  .head p{margin:0;color:var(--text-lo);font-size:13.5px;}
  .range{
    display:flex;align-items:center;gap:8px;
    background:var(--bg-2);border:1px solid var(--line);
    padding:8px 14px;border-radius:10px;font-size:13px;color:var(--text-mid);
  }
  .range svg{width:14px;height:14px;opacity:.8;}

  /* grid */
  .stat-row{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:16px;}
  .mid-row{display:grid;grid-template-columns:1.55fr 1fr;gap:16px;margin-bottom:16px;}
  .low-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  @media (max-width:980px){
    .stat-row{grid-template-columns:repeat(2,1fr);}
    .mid-row,.low-row{grid-template-columns:1fr;}
  }

  .card{
    background:linear-gradient(180deg, var(--bg-2), var(--bg-1));
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:20px 22px;
    position:relative;
    overflow:hidden;
  }
  .card.featured{
    background:linear-gradient(155deg,#1E3D82 0%, #16264F 60%, var(--bg-1) 100%);
    border-color:#2E4E92;
  }

  /* stat cards */
  .stat-top{display:flex;justify-content:space-between;align-items:flex-start;}
  .stat-label{font-size:13.5px;color:var(--text-mid);font-weight:500;}
  .icon-btn{
    width:30px;height:30px;border-radius:50%;
    background:rgba(255,255,255,0.06);
    display:flex;align-items:center;justify-content:center;
    color:var(--text-mid);flex:0 0 auto;
  }
  .icon-btn svg{width:13px;height:13px;}
  .stat-value{font-size:34px;font-weight:700;margin:14px 0 10px;letter-spacing:-0.02em;}
  .stat-value sup{font-size:16px;font-weight:600;color:var(--text-mid);margin-left:2px;}
  .delta-row{display:flex;align-items:center;gap:8px;margin-bottom:14px;}
  .pill{
    display:inline-flex;align-items:center;gap:3px;
    font-size:11.5px;font-weight:700;
    padding:3px 7px;border-radius:6px;
  }
  .pill.up{background:rgba(63,207,142,0.16);color:var(--green);}
  .pill.down{background:rgba(240,118,92,0.16);color:var(--coral);}
  .delta-note{font-size:12.5px;color:var(--text-lo);}
  .spark{width:100%;height:34px;display:block;}

  /* section titles inside wide cards */
  .card h2{font-size:15.5px;font-weight:700;margin:0 0 4px;}
  .card .sub{font-size:12.5px;color:var(--text-lo);margin:0 0 16px;line-height:1.45;}

  /* line chart */
  .chart-wrap{position:relative;height:200px;}
  .chart-wrap svg{width:100%;height:100%;overflow:visible;}
  .xaxis{display:flex;justify-content:space-between;margin-top:10px;font-size:11.5px;color:var(--text-lo);font-family:'SFMono-Regular',Consolas,monospace;}
  .footnote{margin-top:14px;font-size:12.5px;color:var(--text-mid);}
  .footnote b{color:var(--text-hi);}

  /* donut */
  .donut-row{display:flex;align-items:center;gap:26px;}
  .donut-wrap{position:relative;width:150px;height:150px;flex:0 0 auto;}
  .donut-wrap svg{width:100%;height:100%;transform:rotate(-90deg);}
  .donut-center{
    position:absolute;inset:0;display:flex;flex-direction:column;
    align-items:center;justify-content:center;
  }
  .donut-center .big{font-size:24px;font-weight:700;}
  .donut-center .small{font-size:10.5px;color:var(--text-lo);letter-spacing:.03em;margin-top:2px;}
  .legend{display:flex;flex-direction:column;gap:11px;}
  .legend-item{display:flex;align-items:center;gap:9px;font-size:13px;color:var(--text-mid);}
  .dot{width:9px;height:9px;border-radius:3px;flex:0 0 auto;}
  .legend-item b{color:var(--text-hi);margin-left:auto;padding-left:14px;font-weight:700;}

  /* bar lists */
  .bar-item{display:flex;align-items:center;gap:14px;margin-bottom:16px;}
  .bar-item:last-child{margin-bottom:0;}
  .bar-label{width:172px;flex:0 0 auto;font-size:13px;color:var(--text-mid);}
  .bar-track{flex:1;height:9px;border-radius:5px;background:rgba(255,255,255,0.06);overflow:hidden;}
  .bar-fill{height:100%;border-radius:5px;}
  .bar-count{width:42px;flex:0 0 auto;text-align:right;font-size:13.5px;font-weight:700;color:var(--text-hi);}
</style>
</head>
<body>
<div class="wrap">

  <div class="head">
    <div>
      <h1>Economic Development &amp; Culture</h1>
      <p>Small Business Enterprise Centre — client &amp; business activity, year to date</p>
    </div>
    <div class="range">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
      Sep 2025 – Aug 2026
    </div>
  </div>

  <!-- STAT ROW -->
  <div class="stat-row">

    <div class="card featured">
      <div class="stat-top">
        <div class="stat-label">Consultations</div>
        <div class="icon-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M7 17 17 7M9 7h8v8"/></svg></div>
      </div>
      <div class="stat-value">575</div>
      <div class="delta-row"><span class="pill up">↑ 12%</span><span class="delta-note">vs last year</span></div>
      <svg class="spark" viewBox="0 0 200 40" preserveAspectRatio="none">
        <polyline points="0,30 18,26 36,29 55,20 73,14 91,6 109,3 127,9 145,15 164,19 182,24 200,28" fill="none" stroke="#8FB8FF" stroke-width="2.4"/>
      </svg>
    </div>

    <div class="card">
      <div class="stat-top">
        <div class="stat-label">New businesses registered</div>
        <div class="icon-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M7 17 17 7M9 7h8v8"/></svg></div>
      </div>
      <div class="stat-value">96</div>
      <div class="delta-row"><span class="pill up">↑ 8%</span><span class="delta-note">vs last year</span></div>
      <svg class="spark" viewBox="0 0 200 40" preserveAspectRatio="none">
        <polyline points="0,32 20,30 40,27 60,28 80,22 100,18 120,20 140,14 160,12 180,9 200,7" fill="none" stroke="#3FCF8E" stroke-width="2.4"/>
      </svg>
    </div>

    <div class="card">
      <div class="stat-top">
        <div class="stat-label">Program enrollments</div>
        <div class="icon-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M7 17 17 7M9 7h8v8"/></svg></div>
      </div>
      <div class="stat-value">42</div>
      <div class="delta-row"><span class="pill up">↑ 15%</span><span class="delta-note">Summer &amp; Starter Co.</span></div>
      <svg class="spark" viewBox="0 0 200 40" preserveAspectRatio="none">
        <polyline points="0,34 20,33 40,28 60,29 80,20 100,22 120,15 140,17 160,10 180,8 200,4" fill="none" stroke="#F0B44C" stroke-width="2.4"/>
      </svg>
    </div>

    <div class="card">
      <div class="stat-top">
        <div class="stat-label">Open enquiries awaiting triage</div>
        <div class="icon-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M7 17 17 7M9 7h8v8"/></svg></div>
      </div>
      <div class="stat-value">7</div>
      <div class="delta-row"><span class="pill up">↓ 3</span><span class="delta-note">vs last week</span></div>
      <svg class="spark" viewBox="0 0 200 40" preserveAspectRatio="none">
        <polyline points="0,10 20,14 40,12 60,20 80,18 100,26 120,22 140,28 160,30 180,34 200,33" fill="none" stroke="#9B87F5" stroke-width="2.4"/>
      </svg>
    </div>

  </div>

  <!-- MID ROW: monthly trend + source donut -->
  <div class="mid-row">

    <div class="card">
      <h2>Consultations by month</h2>
      <p class="sub">Spring intake climbs as Starter Company &amp; Summer Company applications open.</p>
      <div class="chart-wrap">
        <svg viewBox="0 0 640 200" preserveAspectRatio="none">
          <line x1="0" y1="10" x2="640" y2="10" stroke="#243554" stroke-width="1" stroke-dasharray="3,5"/>
          <line x1="0" y1="72" x2="640" y2="72" stroke="#243554" stroke-width="1" stroke-dasharray="3,5"/>
          <line x1="0" y1="134" x2="640" y2="134" stroke="#243554" stroke-width="1" stroke-dasharray="3,5"/>
          <line x1="0" y1="196" x2="640" y2="196" stroke="#243554" stroke-width="1"/>
          <defs>
            <linearGradient id="fillGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#5B9CF6" stop-opacity="0.35"/>
              <stop offset="100%" stop-color="#5B9CF6" stop-opacity="0"/>
            </linearGradient>
          </defs>
          <path d="M0,150 58,140 116,128 175,163 233,116 291,98 349,54 407,32 465,76 524,100 582,124 640,158 640,196 0,196 Z" fill="url(#fillGrad)"/>
          <polyline points="0,150 58,140 116,128 175,163 233,116 291,98 349,54 407,32 465,76 524,100 582,124 640,158" fill="none" stroke="#5B9CF6" stroke-width="2.75"/>
          <circle cx="407" cy="32" r="6" fill="#0B1220" stroke="#8FB8FF" stroke-width="3"/>
        </svg>
      </div>
      <div class="xaxis"><span>Sep</span><span>Nov</span><span>Jan</span><span>Mar</span><span>May</span><span>Jul</span></div>
      <p class="footnote">Peak month: <b>Apr (74)</b> &nbsp;&nbsp; Quietest month: <b>Aug (31)</b></p>
    </div>

    <div class="card">
      <h2>How consultations arrive</h2>
      <p class="sub">Every channel below writes to the same record in Zoho CRM.</p>
      <div class="donut-row">
        <div class="donut-wrap">
          <svg viewBox="0 0 42 42">
            <circle cx="21" cy="21" r="15.9" fill="transparent" stroke="#1B2A47" stroke-width="5.5"/>
            <circle cx="21" cy="21" r="15.9" fill="transparent" stroke="#5B9CF6" stroke-width="5.5"
              stroke-dasharray="41 59" stroke-dashoffset="0" stroke-linecap="round"/>
            <circle cx="21" cy="21" r="15.9" fill="transparent" stroke="#33C9B0" stroke-width="5.5"
              stroke-dasharray="27 73" stroke-dashoffset="-41" stroke-linecap="round"/>
            <circle cx="21" cy="21" r="15.9" fill="transparent" stroke="#F0B44C" stroke-width="5.5"
              stroke-dasharray="19 81" stroke-dashoffset="-68" stroke-linecap="round"/>
            <circle cx="21" cy="21" r="15.9" fill="transparent" stroke="#9B87F5" stroke-width="5.5"
              stroke-dasharray="9 91" stroke-dashoffset="-87" stroke-linecap="round"/>
            <circle cx="21" cy="21" r="15.9" fill="transparent" stroke="#F0765C" stroke-width="5.5"
              stroke-dasharray="4 96" stroke-dashoffset="-96" stroke-linecap="round"/>
          </svg>
          <div class="donut-center"><div class="big">41%</div><div class="small">WEB FORM</div></div>
        </div>
        <div class="legend">
          <div class="legend-item"><span class="dot" style="background:#5B9CF6"></span>Web form <b>41%</b></div>
          <div class="legend-item"><span class="dot" style="background:#33C9B0"></span>Phone <b>27%</b></div>
          <div class="legend-item"><span class="dot" style="background:#F0B44C"></span>Email <b>19%</b></div>
          <div class="legend-item"><span class="dot" style="background:#9B87F5"></span>Walk-in <b>9%</b></div>
          <div class="legend-item"><span class="dot" style="background:#F0765C"></span>Event <b>4%</b></div>
        </div>
      </div>
    </div>

  </div>

  <!-- LOW ROW: consultation type + geography -->
  <div class="low-row">

    <div class="card">
      <h2>Consultation type</h2>
      <p class="sub">The ministry's core reporting split — same totals for every user.</p>
      <div class="bar-item">
        <div class="bar-label">New business</div>
        <div class="bar-track"><div class="bar-fill" style="width:62%;background:#5B9CF6"></div></div>
        <div class="bar-count">238</div>
      </div>
      <div class="bar-item">
        <div class="bar-label">Existing business</div>
        <div class="bar-track"><div class="bar-fill" style="width:56%;background:#33C9B0"></div></div>
        <div class="bar-count">214</div>
      </div>
      <div class="bar-item">
        <div class="bar-label">General inquiry</div>
        <div class="bar-track"><div class="bar-fill" style="width:14%;background:#9B87F5"></div></div>
        <div class="bar-count">55</div>
      </div>
      <div class="bar-item">
        <div class="bar-label">Succession planning</div>
        <div class="bar-track"><div class="bar-fill" style="width:18%;background:#F0B44C"></div></div>
        <div class="bar-count">68</div>
      </div>
    </div>

    <div class="card">
      <h2>Where clients are located</h2>
      <p class="sub">Residence location — tracked separately from the business address.</p>
      <div class="bar-item">
        <div class="bar-label">Orangeville</div>
        <div class="bar-track"><div class="bar-fill" style="width:82%;background:#5B9CF6"></div></div>
        <div class="bar-count">312</div>
      </div>
      <div class="bar-item">
        <div class="bar-label">Mono</div>
        <div class="bar-track"><div class="bar-fill" style="width:26%;background:#5B9CF6"></div></div>
        <div class="bar-count">98</div>
      </div>
      <div class="bar-item">
        <div class="bar-label">East Garafraxa</div>
        <div class="bar-track"><div class="bar-fill" style="width:16%;background:#5B9CF6"></div></div>
        <div class="bar-count">61</div>
      </div>
      <div class="bar-item">
        <div class="bar-label">Amaranth</div>
        <div class="bar-track"><div class="bar-fill" style="width:12%;background:#5B9CF6"></div></div>
        <div class="bar-count">47</div>
      </div>
      <div class="bar-item">
        <div class="bar-label">Grand Valley / Shelburne</div>
        <div class="bar-track"><div class="bar-fill" style="width:9%;background:#5B9CF6"></div></div>
        <div class="bar-count">34</div>
      </div>
    </div>

  </div>

</div>
</body>
</html>

